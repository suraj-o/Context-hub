generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Users ──────────────────────────────────────────────────

model User {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String      @unique @db.VarChar(255)
  hashedApiKey String      @map("hashed_api_key") @db.VarChar(255)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  workspaces   Workspace[]

  @@map("users")
}

// ── Workspaces ─────────────────────────────────────────────

model Workspace {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  name      String    @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projects  Project[]

  @@map("workspaces")
}

// ── Projects ───────────────────────────────────────────────

model Project {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId   String         @map("workspace_id") @db.Uuid
  name          String         @db.VarChar(255)
  repositoryUrl String?        @map("repository_url") @db.VarChar(500)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz()
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contextEntries ContextEntry[]

  @@map("projects")
}

// ── Context Entries ────────────────────────────────────────

model ContextEntry {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  projectId        String             @map("project_id") @db.Uuid
  contextType      String             @map("context_type") @db.VarChar(50)
  title            String             @db.VarChar(500)
  rawContent       String             @map("raw_content") @db.Text
  processedContent String             @map("processed_content") @db.Text
  sourceFilePath   String?            @map("source_file_path") @db.VarChar(1000)
  sourceLanguage   String?            @map("source_language") @db.VarChar(50)
  sourceLineStart  Int?               @map("source_line_start")
  sourceLineEnd    Int?               @map("source_line_end")
  contentHash      String             @map("content_hash") @db.VarChar(64)
  importanceScore  Int                @default(50) @map("importance_score")
  accessCount      Int                @default(0) @map("access_count")
  lastAccessedAt   DateTime           @default(now()) @map("last_accessed_at") @db.Timestamptz()
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt        DateTime?          @map("deleted_at") @db.Timestamptz()
  metadata         Json               @default("{}")
  parentContextId  String?            @map("parent_context_id") @db.Uuid
  linkedUrls       String[]           @map("linked_urls")

  /// tsvector column for full-text search — managed via raw SQL trigger
  searchVector     Unsupported("tsvector")?  @map("search_vector")

  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentContext    ContextEntry?      @relation("ContextHierarchy", fields: [parentContextId], references: [id])
  childContexts    ContextEntry[]     @relation("ContextHierarchy")
  embeddings       ContextEmbedding[]
  tags             ContextTag[]
  sourceRelations  ContextRelationship[] @relation("SourceRelation")
  targetRelations  ContextRelationship[] @relation("TargetRelation")

  @@unique([projectId, contentHash])
  @@index([projectId], name: "idx_context_project_id")
  @@index([contextType], name: "idx_context_type")
  @@index([contentHash], name: "idx_context_hash")
  @@index([createdAt(sort: Desc)], name: "idx_context_created_at")
  @@index([lastAccessedAt(sort: Desc)], name: "idx_context_last_accessed")
  @@map("context_entries")
}

// ── Context Embeddings ─────────────────────────────────────

model ContextEmbedding {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contextEntryId String       @map("context_entry_id") @db.Uuid
  /// pgvector embedding column — managed via raw SQL
  embedding      Unsupported("vector(384)")
  chunkIndex     Int          @default(0) @map("chunk_index")
  chunkContent   String?      @map("chunk_content") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  contextEntry   ContextEntry @relation(fields: [contextEntryId], references: [id], onDelete: Cascade)

  @@map("context_embeddings")
}

// ── Tags ───────────────────────────────────────────────────

model ContextTag {
  contextId String       @map("context_id") @db.Uuid
  tag       String       @db.VarChar(100)
  context   ContextEntry @relation(fields: [contextId], references: [id], onDelete: Cascade)

  @@id([contextId, tag])
  @@map("context_tags")
}

// ── Relationships ──────────────────────────────────────────

model ContextRelationship {
  sourceId         String       @map("source_id") @db.Uuid
  targetId         String       @map("target_id") @db.Uuid
  relationshipType String       @default("related") @map("relationship_type") @db.VarChar(50)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz()

  source           ContextEntry @relation("SourceRelation", fields: [sourceId], references: [id], onDelete: Cascade)
  target           ContextEntry @relation("TargetRelation", fields: [targetId], references: [id], onDelete: Cascade)

  @@id([sourceId, targetId])
  @@map("context_relationships")
}
