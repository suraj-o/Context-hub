# ── Database ──
DATABASE_URL="postgresql://mcp_user:mcp_password@localhost:5432/mcp_brain?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=300

# ── Embedding Provider ──
EMBEDDING_PROVIDER="openai"          # "openai" or "local"
OPENAI_API_KEY="sk-your-openai-api-key-here"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
LOCAL_EMBEDDING_URL=""               # For Ollama, e.g. http://localhost:11434

# ── Server ──
LOG_LEVEL="info"                     # "debug" | "info" | "warn" | "error"
NODE_ENV="development"

# ── Processing ──
MAX_CHUNK_SIZE=2000
MIN_CONTENT_LENGTH=10

# ── Sync ──
SYNC_WATCH_EXTENSIONS=".ts,.js,.py,.go,.rs"
SYNC_IGNORE_PATTERNS="node_modules,dist,.git,build"
