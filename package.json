{
  "name": "mcp-brain-server",
  "version": "2.0.0",
  "description": "Enterprise-grade MCP Memory Server with PostgreSQL + pgvector + Redis",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "npx prisma generate && tsc",
    "start": "node dist/index.js",
    "dev:watch": "tsx watch src/index.ts",
    "db:generate": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@prisma/client": "^6.6.0",
    "@xenova/transformers": "^2.17.2",
    "chokidar": "^4.0.3",
    "ioredis": "^5.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "prisma": "^6.6.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.1.1"
  }
}
