{
  "name": "mcp-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade MCP Platform monorepo",
  "scripts": {
    "dev": "pnpm --parallel dev",
    "build": "pnpm --filter ./mcp build && pnpm --filter @mcp/api build && pnpm --filter @mcp/web build",
    "start": "pnpm --filter @mcp/api start",
    "dev:docker": "docker-compose -f docker-compose.yml up",
    "prisma:generate": "pnpm --filter ./mcp db:generate",
    "prisma:migrate": "pnpm --filter ./mcp db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "tsx": "^4.19.3"
  },
  "packageManager": "pnpm@9.0.0"
}